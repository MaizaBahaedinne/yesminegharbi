#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost/yesminegharbi/public/'
app.indexPage = ''
app.defaultLocale = 'fr'
app.appTimezone = 'Africa/Tunis'

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver         = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName     = 'yg_session'
session.expiration     = 7200
session.savePath       = 'C:\xampp1\htdocs\yesminegharbi\writable\session'
session.matchIP        = false
session.timeToUpdate   = 300
session.regenerateDestroy = false

#--------------------------------------------------------------------
# SECURITY (CSRF)
#--------------------------------------------------------------------
security.csrfProtection = 'cookie'
security.tokenName      = 'csrf_token'
security.headerName     = 'X-CSRF-TOKEN'
security.cookieName     = 'csrf_cookie'
security.expires        = 7200
security.regenerate     = false
security.redirect       = false
security.samesite       = 'Lax'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = YGBD
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port     = 3307
database.default.DBPrefix =
database.default.charset  = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

#--------------------------------------------------------------------
# ENCRYPTION KEY (generate: php spark key:generate)
#--------------------------------------------------------------------
encryption.key = hex2bin:4a6f6e6573446f655965736d696e654b657948657265303132333435363738

#--------------------------------------------------------------------
# MAIL (SMTP — fill in before production)
#--------------------------------------------------------------------
email.protocol   = smtp
email.SMTPHost   = smtp.example.com
email.SMTPPort   = 587
email.SMTPCrypto = tls
email.SMTPUser   = hello@yesminegharbi.com
email.SMTPPass   = changeme
email.fromEmail  = hello@yesminegharbi.com
email.fromName   = 'Yesmine Gharbi'

#--------------------------------------------------------------------
# ADMIN (changer le mot de passe avant mise en production)
#--------------------------------------------------------------------
admin.email    = admin@yesminegharbi.com
admin.password = Yesmine2025!
