#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost/yesminegharbi/public/'
app.indexPage = ''
app.defaultLocale = 'fr'
app.appTimezone = 'Africa/Tunis'
app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionCookieName = 'yg_session'
app.sessionSavePath = WRITEPATH . 'session'
app.CSRFProtection = true
app.CSRFTokenName  = 'csrf_token'
app.CSRFHeaderName = 'X-CSRF-TOKEN'
app.CSRFCookieName = 'csrf_cookie'
app.CSRFExpire     = 7200
app.CSRFRegenerate = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = yesminegharbi
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.charset  = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

#--------------------------------------------------------------------
# ENCRYPTION KEY (generate: php spark key:generate)
#--------------------------------------------------------------------
encryption.key = hex2bin:your_32_byte_hex_key_here_change_me

#--------------------------------------------------------------------
# MAIL (SMTP — fill in before production)
#--------------------------------------------------------------------
email.protocol   = smtp
email.SMTPHost   = smtp.example.com
email.SMTPPort   = 587
email.SMTPCrypto = tls
email.SMTPUser   = hello@yesminegharbi.com
email.SMTPPass   = changeme
email.fromEmail  = hello@yesminegharbi.com
email.fromName   = Yesmine Gharbi
